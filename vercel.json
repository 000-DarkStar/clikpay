{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/auth/callback/",
      "destination": "/auth/callback.html"
    },
    {
      "source": "/:slug([a-zA-Z0-9]{6})",
      "destination": "https://api.clikpay.fr/:slug"
    }
  ]
}
